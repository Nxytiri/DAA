                  <string name="Source">return {
	dependencies = {
		Promise = "evaera/promise@^4",
		Signal = "sleitnick/signal@^2",
		Symbol = "sleitnick/symbol@^2",
		Trove = "sleitnick/trove@^1",
	},
	package = {
		authors = {"Stephen Leitnick"},
		description = "Component class",
		license = "MIT",
		name = "sleitnick/component",
		realm = "shared",
