          </Item>
          <Item class="Folder" referent="40">
            <Properties>
              <string name="Name">sleitnick_component@2.4.8</string>
            </Properties>
            <Item class="ModuleScript" referent="41">
              <Properties>
                <string name="Name">Promise</string>
