                  <string name="Source">return {
	package = {
		authors = {"Stephen Leitnick"},
		description = "Requires all modules within a given instance",
		license = "MIT",
		name = "sleitnick/loader",
		realm = "shared",
		registry = "https://github.com/UpliftGames/wally-index",
		version = "2.0.0",
	},
}</string>
