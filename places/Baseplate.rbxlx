        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">InitFailure</string>
            <string name="Source"><![CDATA[--//LuauProgrammer
--//InitFailure
--//2026-11-08
--!strict

script:SetAttribute("Required", true)
