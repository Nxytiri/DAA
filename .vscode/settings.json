{
  "luau-lsp.platform.type": "roblox",
  "luau-lsp.sourcemap.rojoProjectFile": "local.project.json",
  "luau-lsp.diagnostics.strictDatamodelTypes": true,
  "luau-lsp.ignoreGlobs": [
    "**/Packages/**",
    "**/ServerPackages/**",
    "**/.tools/**",
    "**/.worktrees/**"
  ],
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true
  },
  "luau-lsp.sourcemap.generatorCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Sourcemap.ps1",
  "luau-lsp.sourcemap.useVSCodeWatcher": true
}
